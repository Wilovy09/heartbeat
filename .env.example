HOST=0.0.0.0
PORT=8090

# Login endpoint this app authenticates against. Its response must include
# `access_token` and `is_admin`
LOGIN_URL=

# Where the registered-apps list (name + logs endpoint URL) is persisted.
APPS_FILE=./data/apps.json

# Set to false only for local http (non-TLS) development -- the session cookie is
# Secure by default and browsers silently drop Secure cookies over plain http.
COOKIE_SECURE=true

# Shared secret sent as X-Admin-Logs-Key on every registered app's logs request, so being
# an admin in ONE environment (whichever LOGIN_URL points at) is enough to view logs from
# apps in ANY environment -- a personal JWT only proves admin status in the environment
# that issued it, since each one provisions accounts independently. Must match
# ADMIN_LOGS_KEY on every registered app that should accept it. Leave unset to disable.
ADMIN_LOGS_KEY=

# Uptime: every registered app's health URL is checked every UPTIME_INTERVAL_SECS; one
# heartbeat history (last 30 days) per app is kept as <slug>.jsonl in UPTIME_DIR.
UPTIME_DIR=./data/uptime
UPTIME_INTERVAL_SECS=60
