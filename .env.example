# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8090
# UI language: es | en
APP_LANG=es
# Public base URL of this deployment (used for links in alerts). Optional.
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# upstream: credentials go to LOGIN_URL, which must answer a JSON {email, password} POST
#           with `access_token` and `is_admin`.
# password: one local admin. Generate the hash with:
#           echo 'your-password' | heartbeat hash-password
AUTH_MODE=upstream
LOGIN_URL=https://api.example.com/auth/login
# upstream: let users without is_admin in as read-only viewers (dashboard only).
UPSTREAM_VIEWERS=false
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=$argon2id$v=19$...
# Optional read-only viewer in password mode (dashboard and uptime data only):
# VIEWER_EMAIL=team@example.com
# VIEWER_PASSWORD_HASH=$argon2id$v=19$...

# Set to false only for local http (non-TLS) development -- the session cookie is
# Secure by default and browsers silently drop Secure cookies over plain http.
COOKIE_SECURE=true
# Sessions survive restarts; the file holds session tokens (written with mode 600).
SESSIONS_FILE=./data/sessions.json

# ---------------------------------------------------------------------------
# Registered apps
# ---------------------------------------------------------------------------
APPS_FILE=./data/apps.json
# REQUIRED. Hosts that registered apps' logs/health URLs may point at (comma-separated;
# *.domain = any subdomain). Only https:// URLs on these hosts are accepted, redirects are
# not followed, and names resolving to private/loopback/link-local IPs are refused --
# these requests carry ADMIN_LOGS_KEY and the admin's JWT.
ALLOWED_HOSTS=*.example.com
# Shared secret sent as X-Admin-Logs-Key on every logs request, so being an admin in one
# environment is enough to read logs from apps in any environment. Must match
# ADMIN_LOGS_KEY on every registered app that should accept it. Leave unset to disable.
ADMIN_LOGS_KEY=

# ---------------------------------------------------------------------------
# Uptime checks
# ---------------------------------------------------------------------------
UPTIME_DIR=./data/uptime
# Default seconds between checks; each app can set its own (10 s to 1 day).
UPTIME_INTERVAL_SECS=60
# Seconds before a check gives up (1-60); each app can override it.
UPTIME_TIMEOUT_SECS=10
# A 2xx slower than this (ms) is "degraded" (yellow). Each app can override it.
UPTIME_DEGRADED_MS=800
# Extra attempts (5 s apart) before a failed check is recorded as down.
UPTIME_RETRIES=2
# A TLS certificate expiring within this many days marks the app degraded.
UPTIME_CERT_WARN_DAYS=14
UPTIME_RETENTION_DAYS=30
# Mass outage: when at least 3 apps and this share (%) of the monitored ones are down at
# once, it's most likely Heartbeat's own network. One notice goes to the global webhooks
# and individual down alerts wait until it's over. 0 = off.
UPTIME_MASS_DOWN_PCT=50

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
# Webhooks notified when an app goes down or recovers (comma-separated). Slack incoming
# webhooks and Discord webhooks get their native format; any other URL gets JSON. Failed
# deliveries are retried (2 s, 10 s, 30 s). Each app can add its own webhooks and
# mentions from /apps.
ALERT_WEBHOOK_URLS=
# Also alert on up <-> degraded changes.
ALERT_ON_DEGRADED=false
# While an app stays down, remind every this many minutes (with mentions). 0 = never.
ALERT_REMIND_MINS=60
# Who to ping when an app goes down (never on recovery), comma-separated. Use IDs, not
# names -- webhooks can't resolve @names:
#   here, channel                 everyone online / everyone in the channel
#   U0123ABCD (or W...)           a Slack user   (profile > ... > Copy member ID)
#   S0123ABCD                     a Slack user group
#   123456789012345678            a Discord user (Developer Mode > Copy User ID)
#   &123456789012345678           a Discord role
# Entries that don't apply to a webhook's service are left out of its message.
ALERT_MENTIONS=
# Alert message templates edited from /settings are stored here.
ALERT_TEMPLATES_FILE=./data/alert_templates.json
# Pinged after every round of checks -- point it at a dead man's switch (e.g.
# healthchecks.io) to find out if Heartbeat itself stops.
HEARTBEAT_PING_URL=

# ---------------------------------------------------------------------------
# Status page and integrations
# ---------------------------------------------------------------------------
# Incident notices published from /notices and shown on each app's /status/{slug} page.
NOTICES_FILE=./data/notices.json
# Enables GET /metrics (Prometheus format) for scrapers sending
# "Authorization: Bearer <METRICS_TOKEN>". Unset = endpoint off.
METRICS_TOKEN=
